<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuração opcional para hospedagem estática do Siga-Rotas em subpasta do
  IIS / ASP.NET WebForms (ex.: ~/SigaApp/SigaRotas/).
  Utiliza apenas <staticContent> com <remove> antes de <mimeMap>, evitando
  conflitos com o Web.config raiz do portal.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json; charset=utf-8" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json; charset=utf-8" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
